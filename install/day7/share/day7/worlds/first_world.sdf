<?xml version="1.0" ?>
<!-- 
=============================================================================
DOSYA: worlds/first_world.sdf
AMAÇ: Gazebo'da ilk basit dünya oluşturma
KULLANIM: gz sim first_world.sdf
ÖĞRENME: SDF format, temel world tanımlama, lighting, physics
=============================================================================
-->

<!-- SDF (Simulation Description Format) versiyonu -->
<sdf version="1.9">
  
  <!-- WORLD TANIMI - Simülasyon ortamının ana container'ı -->
  <world name="first_world">
    
    <!-- =================================================================== -->
    <!-- PHYSICS AYARLARI - Fizik motoru konfigürasyonu -->
    <!-- =================================================================== -->
    
    <!-- Physics engine ayarları -->
    <physics name="1ms" type="ignored">
      <!-- Maksimum step size - ne kadar hassas fizik hesaplaması -->
      <max_step_size>0.001</max_step_size>
      
      <!-- Gerçek zamanlı faktör - 1.0 = gerçek zaman hızı -->
      <real_time_factor>1.0</real_time_factor>
      
      <!-- Gerçek zamanlı update rate - saniyede kaç physics step -->
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    
    <!-- =================================================================== -->
    <!-- PLUGIN'LER - Simülasyon davranışlarını kontrol eden yazılımlar -->
    <!-- =================================================================== -->
    
    <!-- Physics plugin - Fizik motorunu başlatır -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    
    <!-- User commands plugin - Kullanıcı etkileşimi için -->
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    
    <!-- Scene broadcaster - 3D sahne bilgilerini yayınlar -->
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    
    <!-- =================================================================== -->
    <!-- AYDINLATMA - Dünya aydınlatması -->
    <!-- =================================================================== -->
    
    <!-- Güneş ışığı - Ana ışık kaynağı -->
    <light type="directional" name="sun">
      <!-- Işığın pozisyonu (x, y, z koordinatları) -->
      <pose>0 0 10 0 0 0</pose>
      
      <!-- Işık yönü - yukarıdan aşağıya doğru -->
      <direction>-0.5 0.1 -0.9</direction>
      
      <!-- Işık rengi ve parlaklığı (R G B A - 0.0 ile 1.0 arası) -->
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      
      <!-- Işık şiddeti -->
      <intensity>1.0</intensity>
      
      <!-- Işın mesafesi -->
      <range>100</range>
      
      <!-- Gölge ayarları -->
      <cast_shadows>true</cast_shadows>
    </light>
    
    <!-- =================================================================== -->
    <!-- ZEMIN - Dünya zemi i ve gravity -->
    <!-- =================================================================== -->
    
    <!-- Yerçekimi ayarları (x, y, z - metre/saniye²) -->
    <!-- Dünya'da yerçekimi -9.81 m/s² aşağı doğru (z ekseni) -->
    <gravity>0 0 -9.81</gravity>
    
    <!-- Zemin modeli -->
    <model name="ground_plane">
      <!-- Zemin sabit kalacak (hareket etmeyecek) -->
      <static>true</static>
      
      <!-- Zemin geometrisi -->
      <link name="ground_link">
        <!-- Çarpışma geometrisi - fizik hesaplamaları için -->
        <collision name="ground_collision">
          <geometry>
            <!-- Düz zemin - çok büyük bir kutu -->
            <plane>
              <!-- Zemin normali (yukarı bakan) -->
              <normal>0 0 1</normal>
              <!-- Zemin boyutu (x, y boyutları) -->
              <size>100 100</size>
            </plane>
          </geometry>
          
          <!-- Yüzey özellikleri - sürtünme, elastikiyet -->
          <surface>
            <friction>
              <ode>
                <!-- Sürtünme katsayıları -->
                <mu>100</mu>      <!-- Birincil sürtünme -->
                <mu2>50</mu2>     <!-- İkincil sürtünme -->
              </ode>
            </friction>
            
            <!-- Elastikiyet özellikleri -->
            <bounce>
              <restitution_coefficient>0.01</restitution_coefficient>
              <threshold>0.05</threshold>
            </bounce>
          </surface>
        </collision>
        
        <!-- Görsel geometri - ekranda nasıl görüneceği -->
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          
          <!-- Materyal ve renk -->
          <material>
            <!-- Zemin rengi - açık gri -->
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- =================================================================== -->
    <!-- BASİT NESNELER - Test ve görsel çeşitlilik için -->
    <!-- =================================================================== -->
    
    <!-- Kırmızı küp -->
    <model name="red_box">
      <!-- Küpün pozisyonu (x=2, y=0, z=0.5 - zemin üzerinde) -->
      <pose>2 0 0.5 0 0 0</pose>
      
      <link name="box_link">
        <!-- Çarpışma geometrisi -->
        <collision name="box_collision">
          <geometry>
            <!-- 1x1x1 metre küp -->
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
        </collision>
        
        <!-- Görsel geometri -->
        <visual name="box_visual">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
          
          <!-- Kırmızı materyal -->
          <material>
            <ambient>1.0 0.0 0.0 1</ambient>  <!-- Kırmızı -->
            <diffuse>1.0 0.0 0.0 1</diffuse>
            <specular>1.0 1.0 1.0 1</specular>
          </material>
        </visual>
        
        <!-- Fiziksel özellikler -->
        <inertial>
          <!-- Kütle (kg) -->
          <mass>1.0</mass>
          
          <!-- Atalet matrisi - küp için standart değerler -->
          <inertia>
            <ixx>0.167</ixx>
            <iyy>0.167</iyy>
            <izz>0.167</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
      </link>
    </model>
    
    <!-- Mavi silindir -->
    <model name="blue_cylinder">
      <!-- Silindirin pozisyonu -->
      <pose>-2 0 0.5 0 0 0</pose>
      
      <link name="cylinder_link">
        <collision name="cylinder_collision">
          <geometry>
            <!-- Silindir: radius=0.5, height=1.0 -->
            <cylinder>
              <radius>0.5</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
        </collision>
        
        <visual name="cylinder_visual">
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          
          <!-- Mavi materyal -->
          <material>
            <ambient>0.0 0.0 1.0 1</ambient>  <!-- Mavi -->
            <diffuse>0.0 0.0 1.0 1</diffuse>
            <specular>1.0 1.0 1.0 1</specular>
          </material>
        </visual>
        
        <inertial>
          <mass>1.0</mass>
          <!-- Silindir için atalet matrisi -->
          <inertia>
            <ixx>0.146</ixx>
            <iyy>0.146</iyy>
            <izz>0.125</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
      </link>
    </model>
    
    <!-- Yeşil küre -->
    <model name="green_sphere">
      <!-- Kürenin pozisyonu -->
      <pose>0 2 1.0 0 0 0</pose>
      
      <link name="sphere_link">
        <collision name="sphere_collision">
          <geometry>
            <!-- Küre: radius=0.5 -->
            <sphere>
              <radius>0.5</radius>
            </sphere>
          </geometry>
        </collision>
        
        <visual name="sphere_visual">
          <geometry>
            <sphere>
              <radius>0.5</radius>
            </sphere>
          </geometry>
          
          <!-- Yeşil materyal -->
          <material>
            <ambient>0.0 1.0 0.0 1</ambient>  <!-- Yeşil -->
            <diffuse>0.0 1.0 0.0 1</diffuse>
            <specular>1.0 1.0 1.0 1</specular>
          </material>
        </visual>
        
        <inertial>
          <mass>1.0</mass>
          <!-- Küre için atalet matrisi -->
          <inertia>
            <ixx>0.1</ixx>
            <iyy>0.1</iyy>
            <izz>0.1</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
      </link>
    </model>
    
    <!-- =================================================================== -->
    <!-- DUVAR YAPISI - Ortamı ilginç kılmak için -->
    <!-- =================================================================== -->
    
    <!-- Duvar 1 -->
    <model name="wall1">
      <pose>5 0 1 0 0 0</pose>
      <static>true</static>  <!-- Duvar hareket etmez -->
      
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <!-- İnce uzun duvar -->
            <box>
              <size>0.2 10 2</size>
            </box>
          </geometry>
        </collision>
        
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.2 10 2</size>
            </box>
          </geometry>
          
          <!-- Gri duvar -->
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>1.0 1.0 1.0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Duvar 2 -->
    <model name="wall2">
      <pose>-5 0 1 0 0 0</pose>
      <static>true</static>
      
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.2 10 2</size>
            </box>
          </geometry>
        </collision>
        
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.2 10 2</size>
            </box>
          </geometry>
          
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>1.0 1.0 1.0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    
  </world>
</sdf>
